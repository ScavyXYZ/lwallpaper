  <property name="styleSheet">
   <string notr="true">/* ==========================================================================
   MAIN WINDOW AND CENTRAL WIDGET
   ========================================================================== */
QMainWindow, QWidget#centralWidget {
    background-color: #F5F6F8; /* Soft neutral background */
    font-family: &quot;Segoe UI&quot;, &quot;Helvetica Neue&quot;, Arial, sans-serif;
}

/* ==========================================================================
   VIDEO LIST (QListWidget)
   ========================================================================== */
QListWidget {
    background-color: #FFFFFF; /* Clean white for contrast */
    border: 2px solid #D8DDE3; /* Subtle light gray border */
    border-radius: 12px;       /* Rounded corners */
    padding: 8px;
    color: #3C434B;            /* Dark neutral text */
    font-size: 14px;
    outline: 0;                /* Remove the focus frame around items */
}

/* List items */
QListWidget::item {
    padding: 10px 12px;
    border-radius: 8px;
    margin-bottom: 4px;
    color: #3C434B;
}

/* Hovered list item */
QListWidget::item:hover {
    background-color: #E9EFF4; /* Light neutral highlight */
    color: #1E252C;
}

/* Selected (active) list item */
QListWidget::item:selected {
    background-color: #4C7EAE; /* Steel blue accent */
    color: #FFFFFF;            /* White text for readability */
    font-weight: 600;
}

/* ==========================================================================
   COMMON BUTTON STYLES (QPushButton)
   ========================================================================== */
QPushButton {
    background-color: #54708C; /* Base slate blue */
    color: #FFFFFF;
    border: none;
    border-radius: 10px;       /* Rounded button corners */
    font-size: 13px;
    font-weight: bold;
}

/* Effects for regular buttons (Start / Add) */
QPushButton:hover {
    background-color: #46607A; /* Darker on hover */
}

QPushButton:pressed {
    background-color: #385066; /* Deep slate when pressed */
}

/* ==========================================================================
   SEPARATE STYLES FOR THE STOP AND DELETE BUTTONS
   ========================================================================== */
QPushButton#pushButtonStop, QPushButton#pushButtonDelete {
    background-color: #8A97A5; /* Calmer, muted shade */
}

QPushButton#pushButtonStop:hover, QPushButton#pushButtonDelete:hover {
    background-color: #7A8896;
}

QPushButton#pushButtonStop:pressed, QPushButton#pushButtonDelete:pressed {
    background-color: #697684;
}

/* ==========================================================================
   DISABLED BUTTON STATE (when setEnabled(false) is called in code)
   ========================================================================== */
QPushButton:disabled,
QPushButton#pushButtonStop:disabled,
QPushButton#pushButtonDelete:disabled {
    background-color: #E1E4E8; /* Neutral gray */
    color: #A3AAB2;            /* Dimmed text */
}

/* ==========================================================================
   SCROLLBAR (QScrollBar)
   ========================================================================== */
QScrollBar:vertical {
    border: none;
    background: #F5F6F8;
    width: 8px;
    margin: 4px 0 4px 0;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #C6CED6;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #A9B4BF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    border: none;
}</string>
